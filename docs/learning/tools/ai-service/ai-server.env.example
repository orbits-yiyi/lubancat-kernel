# Installed to /etc/default/lubancat-ai; keep credentials out of this file.
# Use absolute paths. This file is read by systemd EnvironmentFile and Bash.
LLAMA_DIR=/home/cat/workspace/ai/llama.cpp
MODEL_PATH=/home/cat/workspace/ai/llama.cpp/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
AI_HOST=0.0.0.0
AI_PORT=8080
AI_THREADS=4
# The original 128-token smoke-test limit cuts off longer chat/code answers.
# Existing installed configuration is preserved; edit it and restart to change limits.
AI_CONTEXT=4096
AI_PREDICT=1024
AI_PARALLEL=1
